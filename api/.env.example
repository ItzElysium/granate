PORT=7071
ALLOW_ORIGIN=https://facturacion.tuempresa.pe
GRANATE_API_KEY=cambia-esta-clave-larga     # la web la envía en X-Granate-Key

# --- Envío a SUNAT ---
SUNAT_AMBIENTE=beta                 # beta | produccion
# SUNAT_RUC=20xxxxxxxxx
# SUNAT_USUARIO_SOL=USUARIOSECUNDARIO
# SUNAT_CLAVE_SOL=********
# CERT_PFX_PATH=./certificado.pfx
# CERT_PFX_PASSWORD=********

# --- Guías de remisión (API REST de SUNAT, solo producción) ---
# SUNAT_GRE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# SUNAT_GRE_CLIENT_SECRET=********

# --- Base de transacciones ---
GRANATE_DB=./data/granate.db

# --- Padrón RUC (lo publica el robot de GitHub) ---
PADRON_REPO=renzotomascoronado-sudo/facturacionelectronica # repo donde corre .github/workflows/padron-sunat.yml
PADRON_GITHUB_TOKEN=github_pat_xxx  # token de solo lectura (Contents: Read) si el repo es privado
PADRON_DB=./data/padron.db
PADRON_ACTUALIZAR_HORAS=6
# PADRON_GITHUB_API=https://api.github.com   # solo para GitHub Enterprise
